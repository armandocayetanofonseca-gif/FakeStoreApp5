<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Empuja el contenido hacia el centro vertical, como en el diseño -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Logo: círculo con borde morado + iniciales "FS" -->
        <FrameLayout
            android:id="@+id/logoCircle"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_logo_circle">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="FS"
                android:textColor="@color/brand_accent"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Título "FakeStore" -->
        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Subtítulo "Bienvenido de nuevo" -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/login_welcome_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!--
            Campo "Usuario": TextInputLayout con estilo "OutlinedBox" =
            el mismo efecto del diseño (etiqueta que se recorta sobre el
            borde de la caja). Cuando el usuario toca el campo, Material
            anima solo la etiqueta hacia arriba y pinta el borde morado
            (ver res/color/til_stroke_color.xml) SIN que tengamos que
            programar nada: es una animación que ya viene incluida.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsername"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:hint="@string/hint_username"
            android:textColorHint="@color/text_secondary"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/til_stroke_color"
            app:hintTextColor="@color/til_hint_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!--
            Campo "Contraseña": mismo estilo + app:endIconMode="password_toggle",
            que agrega el ícono del ojito para mostrar/ocultar la
            contraseña automáticamente (ya animado, sin código extra).
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_password"
            android:textColorHint="@color/text_secondary"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/til_stroke_color"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/text_secondary"
            app:hintTextColor="@color/til_hint_color">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="@color/text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Alerta de credenciales inválidas / error genérico -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/error_alert"
            android:visibility="invisible" />

        <!--
            Botón principal: MaterialButton (no un Button normal) para
            que tenga "ripple" (la ondita que se ve al tocar) de forma
            automática, con color morado sólido y esquinas redondeadas.
        -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/brand_accent"
            android:text="@string/btn_login"
            android:textColor="@color/background_primary"
            android:textStyle="bold"
            app:cornerRadius="27dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</ScrollView>
