<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <!-- Barra superior: título + botón de logout -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Mi Perfil"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <ImageButton
                android:id="@+id/btnLogoutIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cerrar sesión"
                android:src="@drawable/ic_logout" />
        </RelativeLayout>

        <!-- Avatar con insignia de rol superpuesta -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/tvAvatarInitial"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:textColor="@color/text_primary"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRoleBadgeIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/bg_badge_circle"
                android:gravity="center"
                android:textSize="16sp" />
        </FrameLayout>

        <!-- Nombre completo -->
        <TextView
            android:id="@+id/tvFullName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Insignia de rol (pill) -->
        <LinearLayout
            android:id="@+id/pillRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_role_pill"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/tvRolePillIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvRolePillLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tarjeta con datos del perfil -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_card_rounded"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp">

            <!-- Fila: ID de Usuario -->
            <include
                android:id="@+id/rowUserId"
                layout="@layout/item_profile_row" />

            <View style="@style/RowDivider" />

            <!-- Fila: Usuario -->
            <include
                android:id="@+id/rowUsername"
                layout="@layout/item_profile_row" />

            <View style="@style/RowDivider" />

            <!-- Fila: Correo Electrónico -->
            <include
                android:id="@+id/rowEmail"
                layout="@layout/item_profile_row" />

            <View style="@style/RowDivider" />

            <!-- Fila: Teléfono -->
            <include
                android:id="@+id/rowPhone"
                layout="@layout/item_profile_row" />

            <View style="@style/RowDivider" />

            <!-- Fila: Dirección -->
            <include
                android:id="@+id/rowAddress"
                layout="@layout/item_profile_row" />

        </LinearLayout>

        <!-- Botón para entrar al catálogo (US03), disponible para los 3 roles -->
        <Button
            android:id="@+id/btnGoToCatalog"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_admin_action_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:text="🛍️  Ver Catálogo"
            android:textAllCaps="false"
            android:textColor="@color/background_primary"
            android:textStyle="bold" />

        <!-- Botón Cerrar Sesión -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_logout_button"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:text="⎋  Cerrar Sesión"
            android:textAllCaps="false"
            android:textColor="@color/error_alert"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
